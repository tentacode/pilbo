APPLE_TEAM_ID=
DEVICE_ID=
# APP_VARIANT (dev / prod) is set by the Makefile build targets, not here
# App Store Connect API key (make testflight), the .p8 file stays outside the repository
APP_STORE_CONNECT_KEY_ID=
APP_STORE_CONNECT_ISSUER_ID=
APP_STORE_CONNECT_KEY_PATH=
# Android phone used by make android-build-device / android-build-release (adb devices)
ANDROID_DEVICE_ID=
# Android release keystore (make android-build-release), the .jks file stays outside the repository
ANDROID_KEYSTORE_PATH=
ANDROID_KEYSTORE_PASSWORD=
ANDROID_KEY_ALIAS=
ANDROID_KEY_PASSWORD=
