+// Pilbo patch: completion handlers of custom actions, kept until JS has handled the action.
+public final class NotificationActionCompletions {
+  public static let shared = NotificationActionCompletions()
+
+  private struct PendingCompletion {
+    let completionHandler: () -> Void
+    let backgroundTask: UIBackgroundTaskIdentifier
+  }
+
+  private static let timeout: TimeInterval = 25
+  private let lock = NSLock()
+  private var pendingCompletions: [String: PendingCompletion] = [:]
+
+  static func isCustomAction(_ actionIdentifier: String) -> Bool {
+    return actionIdentifier != UNNotificationDefaultActionIdentifier
+      && actionIdentifier != UNNotificationDismissActionIdentifier
+  }
+
+  private static func key(notificationIdentifier: String, actionIdentifier: String) -> String {
+    return "\(notificationIdentifier)|\(actionIdentifier)"
+  }
+
+  func keep(_ response: UNNotificationResponse, completionHandler: @escaping () -> Void) {
+    let key = Self.key(
+      notificationIdentifier: response.notification.request.identifier,
+      actionIdentifier: response.actionIdentifier
+    )
+    let backgroundTask = UIApplication.shared.beginBackgroundTask(withName: key) { [weak self] in
+      self?.complete(key: key)
+    }
+    lock.lock()
+    let previous = pendingCompletions[key]
+    pendingCompletions[key] = PendingCompletion(completionHandler: completionHandler, backgroundTask: backgroundTask)
+    lock.unlock()
+    finish(previous)
+    DispatchQueue.main.asyncAfter(deadline: .now() + Self.timeout) { [weak self] in
+      self?.complete(key: key)
+    }
+  }
+
+  public func complete(notificationIdentifier: String, actionIdentifier: String) {
+    complete(key: Self.key(notificationIdentifier: notificationIdentifier, actionIdentifier: actionIdentifier))
+  }
+
+  private func complete(key: String) {
+    lock.lock()
+    let pendingCompletion = pendingCompletions.removeValue(forKey: key)
+    lock.unlock()
+    finish(pendingCompletion)
+  }
+
+  private func finish(_ pendingCompletion: PendingCompletion?) {
+    guard let pendingCompletion else {
+      return
+    }
+    DispatchQueue.main.async {
+      pendingCompletion.completionHandler()
+      UIApplication.shared.endBackgroundTask(pendingCompletion.backgroundTask)
+    }
+  }
+}
